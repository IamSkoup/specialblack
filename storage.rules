rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Аватары пользователей: avatars/{uid}/{fileName}
    // Читать может кто угодно (аватары показываются в отзывах и публично на сайте),
    // писать/удалять — только владелец, и только картинку до 3 МБ.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Всё остальное закрыто.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
